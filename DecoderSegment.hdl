CHIP DecoderSegment{
    IN in[4];
    OUT d;

    PARTS:
    Not(in=in[3], out=n3);
    Not(in=in[2], out=n2);
    Not(in=in[1], out=n1);
    Not(in=in[0], out=n0);
    And(a=in[3], b=n2, out=t1);
    Or(a=in[1], b=n0, out=o2);
    And(a=n3, b=n2, out=a2);
    And(a=a2, b=o2, out=t2);
    And(a=in[1], b=n0, out=x_a);
    And(a=n1, b=in[0], out=x_b);
    Or(a=x_a, b=x_b, out=x3);
    And(a=n3, b=in[2], out=a3);
    And(a=a3, b=x3, out=t3);
    Or(a=t1, b=t2, out=o_temp);
    Or(a=o_temp, b=t3, out=d);
}